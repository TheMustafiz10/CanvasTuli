{
  "name": "bd-pay-kit",
  "version": "0.1.0-beta.1",
  "description": "Public SDK entry point for Bangladesh payment gateway integrations.",
  "license": "MIT",
  "keywords": [
    "bangladesh",
    "payments",
    "payment-gateway",
    "bkash",
    "sslcommerz",
    "nagad",
    "rocket",
    "typescript",
    "node"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts && node -e \"require('node:fs').rmSync('dist/.tsbuildinfo', { force: true })\"",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true }); require('node:fs').rmSync('README.md', { force: true }); require('node:fs').rmSync('CHANGELOG.md', { force: true }); require('node:fs').rmSync('LICENSE', { force: true })\"",
    "prepack": "node ../../scripts/check-sdk-package.mjs --require-dist && node ../../scripts/prepare-sdk-package.mjs",
    "typecheck": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json --pretty false --noEmit"
  }
}
